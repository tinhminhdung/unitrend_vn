    <rewrite url="^~/thanh-cong/(.*)/(.*).html" to="~/index.aspx?u=Control_All&amp;su=viewcart&amp;id=$1&amp;success=$2" />
    <rewrite url="~/(.*)_id(.*).html" to="~/index.aspx?e=load&amp;hp=${encode($1)}&amp;ipid=${encode($2)}" />
    <rewrite url="~/(.*).html" to="~/index.aspx?e=load&amp;hp=${encode($1)}" />
