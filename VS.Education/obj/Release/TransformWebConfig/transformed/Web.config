    <rewrite url="^~/xac-nhan/(.*)/(.*).aspx" to="~/cms/display/Members/validate.aspx?key=$1" />
    <rewrite url="^~/xac-nhan-email/(.*)/(.*).aspx" to="~/cms/display/Members/infoemail.aspx?key=$1" />
    <rewrite url="^~/thong-tin-thanh-vien.html" to="~/index.aspx?u=Control_All&amp;su=Infos" />
